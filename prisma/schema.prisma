generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CITIZEN
  COLLECTOR
  ADMIN
}

enum CollectionPointStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum LocationSource {
  GPS_COORDINATES
  VERIFIED_ADDRESS
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DisposalStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ContentFormat {
  DISPOSAL_GUIDE
  DIY_TUTORIAL
  QUICK_FACT
  COMMUNITY_EVENT
}

enum ContentLevel {
  ESSENTIAL
  INTERMEDIATE
  ADVANCED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

enum WasteClass {
  CLASS_I
  CLASS_IIA
  CLASS_IIB
}

enum PointCategoryApprovalStatus {
  PENDING
  APPROVED
}

enum PointCategoryDecision {
  APPROVED
  REJECTED
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  name        String
  email       String   @unique
  phone       String
  city        String
  role        Role     @default(CITIZEN)
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collectionPoints   CollectionPoint[]     @relation("CollectorPoints")
  cooperativeProfile CooperativeProfile?
  reviewedPoints     CollectionPoint[]     @relation("ReviewedPoints")
  collections        Collection[]
  disposalRecords    DisposalRecord[]
  reviews            Review[]
  auditLogs          AuditLog[]
  categoryReviews    PointCategoryReview[] @relation("PointCategoryReviewer")

  @@index([createdAt])
}

model CollectionPoint {
  id                  String                @id @default(uuid())
  collectorId         String
  collector           User                  @relation("CollectorPoints", fields: [collectorId], references: [id])
  name                String
  description         String?               @db.Text
  city                String
  address             String
  latitude            Decimal               @db.Decimal(10, 8)
  longitude           Decimal               @db.Decimal(11, 8)
  locationSource      LocationSource        @default(GPS_COORDINATES)
  placeId             String?               @db.VarChar(512)
  whatsappContact     String?
  showWhatsappContact Boolean               @default(false)
  status              CollectionPointStatus @default(PENDING)
  rejectionReason     String?               @db.Text
  reviewedById        String?
  reviewedBy          User?                 @relation("ReviewedPoints", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  hoursConfirmedAt    DateTime              @default(now())
  isOutdated          Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  categories      PointCategory[]
  hours           OperatingHours[]
  configuration   CollectionPointConfiguration?
  geolocation     Geolocation?
  collections     Collection[]
  disposalRecords DisposalRecord[]
  reviews         Review[]
  categoryReviews PointCategoryReview[]

  @@index([status, name])
  @@index([status, city, name])
  @@index([status, latitude, longitude])
  @@index([collectorId])
  @@index([reviewedById])
  @@index([isOutdated, hoursConfirmedAt])
}

model WasteCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?     @db.VarChar(500)
  active      Boolean     @default(true)
  label       String?     @db.VarChar(191)
  wasteClass  WasteClass?

  educationalContents EducationalContent[]

  points          PointCategory[]
  disposalRecords DisposalRecord[]
  pointReviews    PointCategoryReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Waste {
  wasteId   String @id @default(uuid())
  wasteName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PointCategory {
  pointId        String
  categoryId     String
  capacityKg     Decimal?                    @db.Decimal(10, 3)
  isAccepting    Boolean                     @default(true)
  approvalStatus PointCategoryApprovalStatus @default(APPROVED)

  point    CollectionPoint @relation(fields: [pointId], references: [id])
  category WasteCategory   @relation(fields: [categoryId], references: [id])

  @@id([pointId, categoryId])
  @@index([approvalStatus])
}

// Append-only log of every administrator decision on a point's category (BE-21): approvals,
// rejections (with the mandatory reason) and categories added directly by an ADMIN. A rejection
// deletes the PointCategory link, so this table is where the reason survives. Never updated.
model PointCategoryReview {
  id           String                @id @default(uuid())
  pointId      String
  categoryId   String
  decision     PointCategoryDecision
  reason       String?               @db.VarChar(500)
  reviewedById String?
  reviewedAt   DateTime              @default(now())

  point      CollectionPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  category   WasteCategory   @relation(fields: [categoryId], references: [id])
  // SetNull: removing a user (LGPD erasure) keeps the decision but drops who made it.
  reviewedBy User?           @relation("PointCategoryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([pointId, reviewedAt])
  @@index([categoryId])
  @@index([reviewedById])
}

model EducationalContent {
  id                 String        @id @default(uuid())
  title              String
  slug               String        @unique
  summary            String        @db.VarChar(500)
  content            String        @db.Text
  format             ContentFormat @default(DISPOSAL_GUIDE)
  level              ContentLevel  @default(ESSENTIAL)
  readingTimeMinutes Int           @default(3)
  xpReward           Int           @default(0)
  coverImageUrl      String?       @db.VarChar(1000)
  status             ContentStatus @default(DRAFT)
  featured           Boolean       @default(false)
  viewCount          Int           @default(0)
  publishedAt        DateTime?
  categoryId         String
  category           WasteCategory @relation(fields: [categoryId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([format])
  @@index([featured])
}

// Horários de funcionamento de cada ponto de coleta
model OperatingHours {
  id                String          @id @default(uuid())
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  weekday           Weekday
  openTime          DateTime        @db.Time(0)
  closeTime         DateTime        @db.Time(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([collectionPointId])
  @@index([weekday])
}

// Localização geográfica do ponto de coleta (1:1 com CollectionPoint)
model Geolocation {
  id                String          @id @default(uuid())
  collectionPointId String          @unique
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  latitude          Decimal         @db.Decimal(10, 8)
  longitude         Decimal         @db.Decimal(11, 8)
  address           String
  neighborhood      String?
  city              String
  state             String          @db.VarChar(2)
  postalCode        String?         @db.VarChar(20)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([city])
}

// Coleta realizada por um coletor em um ponto de coleta
model Collection {
  id                String           @id @default(uuid())
  collectorId       String
  collector         User             @relation(fields: [collectorId], references: [id])
  collectionPointId String
  collectionPoint   CollectionPoint  @relation(fields: [collectionPointId], references: [id])
  scheduledAt       DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  totalWeightKg     Decimal?         @db.Decimal(10, 3)
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  disposalRecords   DisposalRecord[]

  @@index([collectorId])
  @@index([collectionPointId])
  @@index([collectionPointId, scheduledAt])
}

// Registro de descarte feito por um cidadão (alimenta a gamificação)
model DisposalRecord {
  id                String          @id @default(uuid())
  citizenId         String
  citizen           User            @relation(fields: [citizenId], references: [id])
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  categoryId        String
  category          WasteCategory   @relation(fields: [categoryId], references: [id])
  // Pode ser associado posteriormente a uma coleta
  collectionId      String?
  collection        Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  weightKg          Decimal         @db.Decimal(10, 3)
  pointsEarned      Int             @default(0)
  status            DisposalStatus  @default(PENDING)
  disposedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([citizenId])
  @@index([collectionPointId])
  @@index([categoryId])
  @@index([collectionId])
  @@index([disposedAt, status])
  @@index([collectionPointId, disposedAt])
  @@index([status, disposedAt, categoryId, weightKg, pointsEarned], map: "DisposalRecord_report_cov_idx")
}

// Avaliação feita por cidadão sobre um ponto de coleta
model Review {
  id                String          @id @default(uuid())
  citizenId         String
  citizen           User            @relation(fields: [citizenId], references: [id])
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  rating            Int             @db.UnsignedTinyInt
  comment           String?         @db.Text
  isHidden          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([citizenId, collectionPointId])
  @@index([citizenId])
  @@index([collectionPointId])
  @@index([collectionPointId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  method     String?  @db.VarChar(10)
  route      String?
  resourceId String?
  statusCode Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// Daily count of paid Google Places calls, used to stay inside the free monthly tier.
// day is the calendar date in America/Sao_Paulo ("YYYY-MM-DD").
model PlacesApiUsage {
  sku       String   @db.VarChar(40)
  day       String   @db.Char(10)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([sku, day])
}

model CollectionPointConfiguration {
  collectionPointId String          @id
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  street            String
  streetNumber      String          @db.VarChar(20)
  neighborhood      String
  state             String          @db.Char(2)
  postalCode        String          @db.VarChar(8)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model CooperativeProfile {
  collectorId     String   @id
  collector       User     @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  cooperativeName String
  cnpj            String   @db.VarChar(14)
  email           String   @db.VarChar(254)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cnpj])
}
