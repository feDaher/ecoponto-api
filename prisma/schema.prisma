generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CITIZEN
  COLLECTOR
  ADMIN
}

enum CollectionPointStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String            @id @default(uuid())
  firebaseUid      String            @unique
  name             String
  email            String            @unique
  phone            String
  city             String
  role             Role              @default(CITIZEN)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  collectionPoints CollectionPoint[]

  createdPoints  CollectionPoint[] @relation("CreatedPoints")
  approvedPoints CollectionPoint[] @relation("ApprovedPoints")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollectionPoint {
  id                  String                @id @default(uuid())
  collectorId         String
  collector           User                  @relation(fields: [collectorId], references: [id])
  name                String
  description         String?               @db.Text
  city                String
  address             String
  latitude            Decimal               @db.Decimal(10, 8)
  longitude           Decimal               @db.Decimal(11, 8)
  whatsappContact     String?
  showWhatsappContact Boolean               @default(false)
  wasteCategories     Json
  operatingHours      Json
  status              CollectionPointStatus @default(PENDING)
  rejectionReason     String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status, city])
  @@index([collectorId])

  createdById String
  createdBy   User   @relation("CreatedPoints", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedPoints", fields: [approvedById], references: [id])

  approvedAt DateTime?

  categories PointCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WasteCategory {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)

  points PointCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Waste {
  wasteId     String  @id @default(uuid())
  wasteName   String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PointCategory {
  pointId    String
  categoryId String

  point    CollectionPoint @relation(fields: [pointId], references: [id])
  category WasteCategory   @relation(fields: [categoryId], references: [id])

  @@id([pointId, categoryId])
}
