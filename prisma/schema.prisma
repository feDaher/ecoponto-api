// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CITIZEN
  COLLECTOR
  ADMIN
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  name        String
  email       String   @unique
  phone       String
  city        String
  role        Role     @default(CITIZEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OperatingHours {
  id                String          @id @default(uuid())
  collectionPointId String
  weekday           Weekday
  openTime          String
  closeTime         String
  collectionPoint   collectionPoint @relation(fields: [collectionPointId], references: [id])

  @@unique([collectionPointId, weekday])
}

model CollectionPoint {
  id                  String                @id @default(uuid())
  collectorId         String
  collector           User                  @relation(fields: [collectorId], references: [id])
  name                String
  description         String?               @db.Text
  city                String
  address             String
  latitude            Decimal               @db.Decimal(10, 8)
  longitude           Decimal               @db.Decimal(11, 8)
  whatsappContact     String?
  showWhatsappContact Boolean               @default(false)
  wasteCategories     Json
  operatingHours      Json
  status              CollectionPointStatus @default(PENDING)
  rejectionReason     String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status, city])
  @@index([collectorId])

  createdById String
  createdBy   User   @relation("CreatedPoints", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedPoints", fields: [approvedById], references: [id])

  approvedAt DateTime?

  categories PointCategory[]
  operatingHours operatingHours[]

  hoursConfirmedAt DataTime @default(now())
  isOutdated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}