DATABASE_URL="mysql://ecoponto_app:SENHA@localhost:3306/ecoponto"
# Réplica somente leitura (relatórios/dashboard), com usuário que só tem SELECT.
# Se vazio, as leituras de relatório usam o DATABASE_URL.
DATABASE_REPLICA_URL="mysql://ecoponto_reader:SENHA_LEITURA@localhost:3308/ecoponto"
PORT=3333

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=

DB_POOL_LIMIT=20
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_POOL_IDLE_TIMEOUT_S=300
DB_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_MAX=100
# Atras de proxy reverso (Render, Railway, Nginx...): numero de saltos, normalmente 1.
# Vazio = desligado (desenvolvimento local).
TRUST_PROXY=
# Origens do navegador permitidas, separadas por virgula. Vazio = qualquer origem.
CORS_ORIGINS=

GOOGLE_MAPS_API_KEY=
# Limite diário de chamadas pagas ao Google Places (zera à meia-noite de Brasília).
# 250/dia × 31 = 7.750/mês, abaixo das 10.000 gratuitas/mês de cada SKU.
PLACES_AUTOCOMPLETE_DAILY_LIMIT=250
PLACES_DETAILS_DAILY_LIMIT=250
